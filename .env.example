OPENAI_API_KEY=
# Required for slash commands. Keep the token in the local .env file.
DISCORD_BOT_TOKEN=
# Comma-separated Discord user IDs allowed to use slash commands without server admin.
BOT_OPERATOR_IDS=277763680022560768
# Optional for the manual send-now command. Server admins normally choose the channel in Discord.
DISCORD_CHANNEL_ID=
# Optional alternative for the manual send-now command.
DISCORD_WEBHOOK_URL=

# Asia/Seoul local time. End time is exclusive; the dawn window crosses midnight.
TIMEZONE=Asia/Seoul
DAWN_WINDOW=22:00-04:00
LUNCH_WINDOW=11:30-13:30

# Cheaper default; raise to medium only if faces or details look poor.
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=low
IMAGE_SIZE=1024x1024
PROMPT_MODEL=gpt-6-luna
PHOTO_COUNT=2

# Optional when running locally. Docker Compose sets this to /app/data.
# BOT_DATA_DIR=/path/to/persistent/data
